# Copy to .env.local for local development. Never commit real values.

# --- Browser (bundled into the app; safe to expose) ---
# Your Supabase project URL and anon (public) key: Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-your-anon-key
# Local development only: show an email/password form for the fictional seed users
VITE_DEV_EMAIL_LOGIN=false

# --- Server (Netlify Functions only; never exposed to the browser) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Comma-separated emails that may use the operator page
OPERATOR_EMAILS=operator@example.com
# Shown on the Privacy page: who runs this copy
OPERATOR_NAME=Demo Operator
# invite_only (default) or open
HOUSEHOLD_CREATION=invite_only
# Per-household file storage quota in MB
HOUSEHOLD_STORAGE_MB=250
# Public URL of the deployed site, no trailing slash
SITE_URL=http://localhost:5173

# --- Local Supabase Google provider (supabase/config.toml reads these) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
